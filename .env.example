# PostgreSQL
POSTGRES_USER=praktikus
POSTGRES_PASSWORD=praktikus_dev
POSTGRES_DB=praktikus

# Redis
REDIS_PORT=6379

# Backend
PORT=3000
NODE_ENV=development
DB_HOST=postgres
DB_PORT=5432
DB_USER=praktikus
DB_PASS=praktikus_dev
DB_NAME=praktikus
REDIS_HOST=redis
JWT_SECRET=dev_secret_change_in_production_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Asaas (usar "mock" para desenvolvimento local)
ASAAS_API_KEY=mock
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_PLAN_VALUE=69.90

# Frontend
# Use /api para que o Nginx do container faca proxy para o backend (mesma origem).
VITE_API_URL=/api
# Hostname do backend usado pelo Nginx do frontend (docker-compose: backend; Fly: praktikus-backend.internal)
BACKEND_HOST=backend
